# SentinelTrace Staging / Production Environment Variables

# ── Application Environment ────────────────────────────────────────────────
APP_NAME="SentinelTrace"
APP_ENV="staging" # or "production"
APP_DEBUG="false"
APP_SECRET_KEY="<insert-secure-random-string-at-least-32-chars>"
ALLOWED_ORIGINS=["https://staging.sentineltrace.example.com"]
FRONTEND_URL="https://staging.sentineltrace.example.com"

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB="sentineltrace"
POSTGRES_USER="sentineltrace"
POSTGRES_PASSWORD="<insert-secure-db-password>"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="<insert-secure-neo4j-password>"
NEO4J_DATABASE="neo4j"

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD="<insert-secure-redis-password>"
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"

# ── JWT / Authentication ───────────────────────────────────────────────────
JWT_SECRET="<insert-secure-random-string-for-jwt-signing>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# ── Google OAuth / Gmail ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID="<insert-google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<insert-google-oauth-client-secret>"
GOOGLE_REDIRECT_URI="https://staging.sentineltrace.example.com/api/v1/auth/google/callback"
GOOGLE_SCOPES="openid email profile"

GMAIL_CLIENT_ID="<insert-gmail-oauth-client-id>"
GMAIL_CLIENT_SECRET="<insert-gmail-oauth-client-secret>"
GMAIL_REDIRECT_URI="https://staging.sentineltrace.example.com/api/v1/integrations/gmail/callback"
GMAIL_ENCRYPTION_KEY="<insert-32-byte-base64-fernet-key-for-oauth-token-encryption>"

# ── Threat Intelligence & Geolocation ──────────────────────────────────────
MAXMIND_CITY_DB_PATH=./data/GeoLite2-City.mmdb
MAXMIND_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
VIRUSTOTAL_API_KEY="<insert-virustotal-api-key>"
ABUSEIPDB_API_KEY="<insert-abuseipdb-api-key>"
SHODAN_API_KEY="<insert-shodan-api-key>"


# ── Encryption ─────────────────────────────────────────────────────────────
FILE_ENCRYPTION_KEY="<insert-32-byte-base64-fernet-key-for-file-encryption>"

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"
