# =============================================================================
# SentinelTrace Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── DATABASE ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentineltrace
POSTGRES_USER=sentineltrace
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── NEO4J ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_key_must_be_at_least_64_chars_and_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── GOOGLE ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── GMAIL ────────────────────────────────────────────────────────────────────
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# ─── GOOGLE CLOUD ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=sentineltrace-evidence

# ─── THREAT INTELLIGENCE ──────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ─── MCP ──────────────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8001
